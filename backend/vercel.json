{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "schedules": {
    "ranking-sync": {
      "schedule": "0 3 * * *",
      "function": "api/schedule-ranking",
      "timezone": "Asia/Ho_Chi_Minh"
    },
    "match-sync": {
      "schedule": "0 0,6,12,18 * * *",
      "function": "api/schedule-matches",
      "timezone": "Asia/Ho_Chi_Minh"
    },
    "profile-reconcile": {
      "schedule": "0 4 * * *",
      "function": "api/schedule-profile-reconcile",
      "timezone": "Asia/Ho_Chi_Minh"
    }
  },
  "functions": {
    "api/schedule-ranking.ts": {
      "experimentalTriggers": [
        {
          "type": "schedule/v1beta"
        }
      ]
    },
    "api/schedule-matches.ts": {
      "experimentalTriggers": [
        {
          "type": "schedule/v1beta"
        }
      ]
    },
    "api/schedule-profile-reconcile.ts": {
      "experimentalTriggers": [
        {
          "type": "schedule/v1beta"
        }
      ]
    }
  }
}