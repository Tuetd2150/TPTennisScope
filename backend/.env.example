# Provider configuration (RapidAPI / Matchstat)
RAPIDAPI_KEY=
RAPIDAPI_HOST=tennis-api-atp-wta-itf.p.rapidapi.com

# Database (PostgreSQL / Neon on Vercel)
DATABASE_URL=postgresql://postgres:your_password@localhost:5433/tennisscope?schema=public

# Server configuration
PORT=5000
NODE_ENV=development

# CORS configuration
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Sync & Quota invariants
SYNC_TIMEZONE=Asia/Ho_Chi_Minh
DAILY_API_REQUEST_BUDGET=45
RAPIDAPI_QUOTA_RESET_UTC=08:23

# Vercel Cron & Serverless scheduling
CRON_SECRET=your_random_secure_cron_secret
ENABLE_LOCAL_SCHEDULER=true
ENABLE_PRODUCTION_CRON=false
